{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": "./types",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "types/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}