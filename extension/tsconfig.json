{
    "extends": "plasmo/templates/tsconfig.base",
    "exclude": [
        "node_modules"
    ],
    "include": [
        ".plasmo/index.d.ts",
        "./**/*.ts",
        "./**/*.tsx"
    ],
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2020"
        ],
        "paths": {
            "~*": [
                "./*"
            ]
        },
        "baseUrl": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "preact"
    }
}